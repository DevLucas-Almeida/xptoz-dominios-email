# =============================================================================
# Copie este arquivo para .env e preencha os valores:
#     cp .env.example .env
# O .env está no .gitignore e NUNCA deve ser versionado.
# =============================================================================

# -----------------------------------------------------------------------------
# Banco de dados do desafio (onde fica users_info e as camadas do dbt)
# Usado pelo script de carga, pelo dbt e pelas DAGs.
#
# Opção A — Postgres local (container "warehouse" do docker-compose):
#   PG_HOST=warehouse  PG_PORT=5432  PG_SSLMODE=disable
#   (usuário, senha e banco iguais aos de LOCAL_PG_* abaixo)
#
# Opção B — Postgres no Render (dados da aba "Connect > External"):
#   PG_HOST=<host externo, ex.: dpg-xxxx-a.virginia-postgres.render.com>
#   PG_PORT=5432  PG_SSLMODE=require   (o Render recusa sslmode=disable)
# -----------------------------------------------------------------------------
PG_HOST=warehouse
PG_PORT=5432
PG_USER=xptoz
PG_PASSWORD=xptoz_local
PG_DBNAME=xptoz
PG_SSLMODE=disable

# -----------------------------------------------------------------------------
# Credenciais do Postgres local (container "warehouse"). Só valem na sua máquina.
# -----------------------------------------------------------------------------
LOCAL_PG_USER=xptoz
LOCAL_PG_PASSWORD=xptoz_local
LOCAL_PG_DB=xptoz

# -----------------------------------------------------------------------------
# Airflow
# -----------------------------------------------------------------------------
# Linux: use o resultado de `id -u`. Windows/macOS: pode manter 50000.
AIRFLOW_UID=50000

# Chave de criptografia das connections/variables do Airflow. Gere com:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# Segredo compartilhado entre api-server e scheduler (troque por um valor aleatório):
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
AIRFLOW__API_AUTH__JWT_SECRET=troque-por-um-segredo-aleatorio

# Usuário de login da UI do Airflow (http://localhost:8080)
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow
